@using Dentistry.ViewModels.Catalog.AppSettings
@model AppSettingDataVm

<style>
    #app-setting-form {
        display: flex;
        flex-direction: column;
        height: 100%;
        position: relative;
    }

    .app-setting-layout {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }
    .app-setting-toc {
        flex: 0 0 230px;
        width: 230px;
        position: sticky;
        top: 0;
        max-height: 75vh;
        overflow-y: auto;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: .5rem;
    }
    .app-setting-toc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: .6rem .9rem;
        border-bottom: 1px solid #eee;
        font-weight: 600;
    }
    .app-setting-toc-toggle-btn,
    .app-setting-toc-open-btn {
        border: none;
        background: transparent;
        color: #6c757d;
        cursor: pointer;
        padding: .2rem .4rem;
        line-height: 1;
    }
    .app-setting-toc-open-btn {
        flex: 0 0 auto;
        position: sticky;
        top: 0;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: .5rem;
    }
    .app-setting-toc-list {
        margin: 0;
        padding: .4rem 0;
    }
    .app-setting-toc-list a {
        display: block;
        padding: .45rem .9rem;
        font-size: .92rem;
        color: #495057;
        text-decoration: none;
        border-left: 3px solid transparent;
    }
    .app-setting-toc-list a:hover {
        background: #f8f9fa;
    }
    .app-setting-toc-list a.active {
        background: #e7f1ff;
        color: #0d6efd;
        font-weight: 600;
        border-left-color: #0d6efd;
    }
    .app-setting-content {
        flex: 1 1 auto;
        min-width: 0;
    }
</style>
<div id="app-setting-form" class="container-fluid mt-4">
    <!-- Name hiển thị và căn giữa -->
    <h3 class="text-center mb-4">@Model.Setting.Name</h3>

    <div class="app-setting-layout">
        <!-- Mục lục các mục cài đặt - highlight mục đang xem khi cuộn, click để nhảy tới -->
        <nav class="app-setting-toc" id="appSettingToc">
            <div class="app-setting-toc-header">
                <span><i class="fa-solid fa-list-ul me-1"></i> Mục lục</span>
                <button type="button" id="appSettingTocToggle" class="app-setting-toc-toggle-btn" title="Ẩn mục lục">
                    <i class="fa-solid fa-angles-left"></i>
                </button>
            </div>
            <ul class="app-setting-toc-list list-unstyled">
                <li><a href="#setting-section-company" class="app-setting-toc-link" data-target="setting-section-company">Thông tin công ty</a></li>
                <li><a href="#setting-section-seo" class="app-setting-toc-link" data-target="setting-section-seo">SEO chia sẻ link</a></li>
                <li><a href="#setting-section-hotline" class="app-setting-toc-link" data-target="setting-section-hotline">Hotline</a></li>
                <li><a href="#setting-section-worktime" class="app-setting-toc-link" data-target="setting-section-worktime">Giờ làm việc</a></li>
                <li><a href="#setting-section-social" class="app-setting-toc-link" data-target="setting-section-social">Mạng xã hội</a></li>
                <li><a href="#setting-section-contact" class="app-setting-toc-link" data-target="setting-section-contact">Đăng ký liên hệ</a></li>
                <li><a href="#setting-section-category" class="app-setting-toc-link" data-target="setting-section-category">Danh mục nổi bật</a></li>
                <li><a href="#setting-section-categoryProduct" class="app-setting-toc-link" data-target="setting-section-categoryProduct">Danh mục Sản phẩm</a></li>
                <li><a href="#setting-section-doctor" class="app-setting-toc-link" data-target="setting-section-doctor">Slide bác sĩ</a></li>
                <li><a href="#setting-section-feedback" class="app-setting-toc-link" data-target="setting-section-feedback">Phản hồi khách hàng</a></li>
                <li><a href="#setting-section-email" class="app-setting-toc-link" data-target="setting-section-email">Email thông báo</a></li>
            </ul>
        </nav>
        <button type="button" id="appSettingTocOpenBtn" class="app-setting-toc-open-btn d-none" title="Hiện mục lục">
            <i class="fa-solid fa-bars"></i>
        </button>

        <div class="app-setting-content">
    <!-- Form cập nhật -->
    <form id="updateForm" asp-action="UpdateSetting" asp-controller="AppSetting" method="post" class="row g-3">
        <input asp-for="@Model.Setting.Id" type="hidden" />
        <!-- Company info -->
        <div class="col-12" id="setting-section-company">
            <div class="card">
                <div class="card-header">Thông tin công ty</div>
                <div class="card-body row g-3">

                    <div class="col-md-12">
                        <label asp-for="@Model.Setting.Name" class="form-label">Tên website</label>
                        <input type="text" class="form-control" asp-for="@Model.Setting.Name" required>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="@Model.Setting.CompanyTitle" class="form-label">Tiêu đề công ty</label>
                        <input type="text" class="form-control" asp-for="@Model.Setting.CompanyTitle">
                    </div>
                    <div class="col-md-12">
                        <label asp-for="@Model.Setting.BranchesTitle" class="form-label">Tiêu đề cơ sở liên kết</label>
                        <input type="text" class="form-control" asp-for="@Model.Setting.BranchesTitle">
                    </div>
                    <div class="col-md-12">
                        <label asp-for="@Model.Setting.CompanyName" class="form-label">Tên công ty</label>
                        <input type="text" class="form-control" asp-for="@Model.Setting.CompanyName">
                    </div>
                    <div class="col-md-6">
                        <label asp-for="@Model.Setting.CompanyAddress" class="form-label">Địa chỉ</label>
                        <input type="text" class="form-control" asp-for="@Model.Setting.CompanyAddress">
                    </div>
                    <div class="col-md-6">
                        <label asp-for="@Model.Setting.CompanyEmail" class="form-label">Email</label>
                        <input type="text" class="form-control" asp-for="@Model.Setting.CompanyEmail">
                    </div>
                    <div class="col-md-6">
                        <label asp-for="@Model.Setting.CompanyPhone" class="form-label">Điện thoại</label>
                        <input type="text" class="form-control" asp-for="@Model.Setting.CompanyPhone">
                    </div>
                    <div class="col-md-6">
                        <label asp-for="@Model.Setting.CompanyWebsite" class="form-label">Website</label>
                        <input type="text" class="form-control" asp-for="@Model.Setting.CompanyWebsite">
                    </div>
                </div>
            </div>
        </div>
        <!-- SEO chia sẻ link trang chủ -->
        <div class="col-12" id="setting-section-seo">
            <div class="card">
                <div class="card-header">SEO chia sẻ link (Trang chủ)</div>
                <div class="card-body row g-3">
                    <div class="col-md-12">
                        <label asp-for="@Model.Setting.Description" class="form-label">Mô tả website (hiển thị khi gửi link)</label>
                        <textarea class="form-control" rows="3" asp-for="@Model.Setting.Description" placeholder="Mô tả ngắn gọn hiển thị khi chia sẻ link trang chủ"></textarea>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Ảnh mặc định trang chủ (hiển thị khi gửi link)</label>
                        <div class="form-text mb-2">Nếu để trống, hệ thống sẽ dùng logo làm ảnh mặc định.</div>
                        <ul class="nav nav-tabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="home-image-tab-url-btn" data-bs-toggle="tab" data-bs-target="#home-image-tab-url" type="button" role="tab">Dán link ảnh</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="home-image-tab-unsplash-btn" data-bs-toggle="tab" data-bs-target="#home-image-tab-unsplash" type="button" role="tab">Tìm trên Unsplash</button>
                            </li>
                        </ul>
                        <div class="tab-content border border-top-0 p-3">
                            <div class="tab-pane fade show active" id="home-image-tab-url" role="tabpanel">
                                <div class="input-group">
                                    <input type="url" id="homeImageUrlInput" class="form-control" placeholder="Dán đường dẫn ảnh (https://...)">
                                    <button type="button" id="btn-preview-home-image-url" class="btn btn-outline-secondary">Xem trước</button>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="home-image-tab-unsplash" role="tabpanel">
                                <div class="input-group mb-2">
                                    <input type="text" id="homeImageUnsplashQuery" class="form-control" placeholder="Nhập từ khóa (vd: dental clinic)">
                                    <button type="button" id="btn-search-home-image-unsplash" class="btn btn-outline-secondary">Tìm kiếm</button>
                                </div>
                                <div id="home-image-unsplash-results" class="d-flex flex-wrap gap-2"></div>
                            </div>
                        </div>
                        <input type="hidden" asp-for="@Model.Setting.HomeImageUrl" id="homeImageUrlHidden" />
                        @{
                            var hasHomeImage = !string.IsNullOrEmpty(Model.Setting.HomeImageUrl);
                            <div id="home-image-preview-container" class="mt-2" style="display: @(hasHomeImage ? "block" : "none")">
                                <label>Xem trước:</label>
                                <img id="home-image-preview" src="@Model.Setting.HomeImageUrl" alt="Ảnh trang chủ" class="mt-2 d-block" style="max-height: 120px;" />
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Hotline Group -->
        <div class="col-12" id="setting-section-hotline">
            <div class="card">
                <div class="card-header">Hotline</div>
                <div class="card-body row g-3">
                    <div class="col-md-6">
                        <label asp-for="@Model.Setting.HotlineHaNoi" class="form-label">Hotline Hà Nội</label>
                        <input type="text" class="form-control" asp-for="@Model.Setting.HotlineHaNoi">
                    </div>
                    <div class="col-md-6">
                        <label asp-for="@Model.Setting.ZaloHotline" class="form-label">Zalo</label>
                        <input type="text" class="form-control" asp-for="@Model.Setting.ZaloHotline">
                    </div>
                </div>
            </div>
        </div>

        <!-- Work Time Group -->
        <div class="col-12" id="setting-section-worktime">
            <div class="card">
                <div class="card-header">Giờ làm việc</div>
                <div class="card-body row g-3">
                    <div class="col-md-6">
                        <label asp-for="@Model.Setting.StartWork" class="form-label">Giờ mở cửa</label>
                        <input type="text" class="form-control" asp-for="@Model.Setting.StartWork">
                    </div>
                    <div class="col-md-6">
                        <label asp-for="@Model.Setting.EndWork" class="form-label">Giờ đóng cửa</label>
                        <input type="text" class="form-control" asp-for="@Model.Setting.EndWork">
                    </div>
                </div>
            </div>
        </div>

        <!-- Social Group -->
        <div class="col-12" id="setting-section-social">
            <div class="card">
                <div class="card-header">Mạng xã hội</div>
                <div class="card-body row g-3">
                    <div class="col-md-6">
                        <label asp-for="@Model.Setting.Facebook" class="form-label">Facebook</label>
                        <input type="text" class="form-control" asp-for="@Model.Setting.Facebook">
                    </div>
                    <div class="col-md-6">
                        <label asp-for="@Model.Setting.Instagram" class="form-label">Instagram</label>
                        <input type="text" class="form-control" asp-for="@Model.Setting.Instagram">
                    </div>
                    <div class="col-md-6">
                        <label asp-for="@Model.Setting.Twitter" class="form-label">Twitter</label>
                        <input type="text" class="form-control" asp-for="@Model.Setting.Twitter">
                    </div>
                    <div class="col-md-6">
                        <label asp-for="@Model.Setting.Youtube" class="form-label">Youtube</label>
                        <input type="text" class="form-control" asp-for="@Model.Setting.Youtube">
                    </div>
                    <div class="col-md-6">
                        <label asp-for="@Model.Setting.Tiktok" class="form-label">TikTok</label>
                        <input type="text" class="form-control" asp-for="@Model.Setting.Tiktok">
                    </div>
                </div>
            </div>
        </div>

        @* Liên hệ *@
        <div class="col-12" id="setting-section-contact">
            <div class="card">
                <div class="card-header">
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="@Model.Setting.ShowContactList">
                            <label class="form-check-label" asp-for="@Model.Setting.ShowContactList">Đăng ký liên hệ</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @* Danh mục dịch vụ *@
        <div class="col-12" id="setting-section-category">
            <div class="card">
                <div class="card-header">
                    <div class="col-12">
                        <div id="setting-category-header" class="form-check form-switch">
                            <input type="hidden" asp-for="@Model.Setting.Categories" id="categoryIdsInput">
                            <input class="form-check-input" type="checkbox" asp-for="@Model.Setting.ShowCategoryList" id="setting_show_category">
                            <label class="form-check-label" asp-for="@Model.Setting.ShowCategoryList">Danh mục nổi bật</label>
                        </div>
                    </div>
                </div>
                @{
                    string categoryDisplay = Model.Setting.ShowCategoryList ? "block" : "none";
                    <div class="card-body row g-3 setting-category-body" style="display: @categoryDisplay">
                        <div class="col-12">
                            <label asp-for="@Model.Setting.CategoryListTitle" class="form-label">Tiêu đề</label>
                            <input type="text" class="form-control" asp-for="@Model.Setting.CategoryListTitle">
                        </div>
                        <div class="col-12">
                            <label asp-for="@Model.Setting.CategoryListSubTitle" class="form-label">Tiêu đề phụ</label>
                            <input type="text" class="form-control" asp-for="@Model.Setting.CategoryListSubTitle">
                        </div>
                        <!-- Table -->
                        <table id="categoryTableList" class="table table-striped table-hover table-bordered">
                            <thead>
                                <tr>
                                    <th class="setting-category-cell-checkbox">Chọn</th>
                                    <th>Tên danh mục</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var category in Model.Categories)
                                {
                                    <tr>
                                        <td class="setting-category-cell-checkbox">
                                            @if (Model.Setting.Categories.Split(',').Contains(category.Id.ToString())) {
                                                <input type="checkbox" class="category-checkbox" data-checkbox="@category.Id" value="@category.Id" checked>
                                            } else {                                             
                                                <input type="checkbox" class="category-checkbox" data-checkbox="@category.Id" value="@category.Id">
                                            }

                                        </td>
                                        <td>@category.Name</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        @* Danh mục Sản phẩm *@
        <div class="col-12" id="setting-section-categoryProduct">
            <div class="card">
                <div class="card-header">
                    <div class="col-12">
                        <div id="setting-categoryProduct-header" class="form-check form-switch">
                            <input type="hidden" asp-for="@Model.Setting.CategoryProducts" id="categoryProductIdsInput">
                            <input class="form-check-input" type="checkbox" asp-for="@Model.Setting.ShowCategoryProductList" id="setting_show_categoryProduct">
                            <label class="form-check-label" asp-for="@Model.Setting.ShowCategoryProductList">Danh mục Sản phẩm nổi bật</label>
                        </div>
                    </div>
                </div>
                @{
                    string categoryProductDisplay = Model.Setting.ShowCategoryProductList ? "block" : "none";
                    <div class="card-body row g-3 setting-categoryProduct-body" style="display: @categoryProductDisplay">
                        <div class="col-12">
                            <label asp-for="@Model.Setting.CategoryListProductTitle" class="form-label">Tiêu đề</label>
                            <input type="text" class="form-control" asp-for="@Model.Setting.CategoryListProductTitle">
                        </div>
                        <div class="col-12">
                            <label asp-for="@Model.Setting.CategoryListProductSubTitle" class="form-label">Tiêu đề phụ</label>
                            <input type="text" class="form-control" asp-for="@Model.Setting.CategoryListProductSubTitle">
                        </div>
                        <!-- Table -->
                        <table id="categoryProductTableList" class="table table-striped table-hover table-bordered">
                            <thead>
                                <tr>
                                    <th class="setting-categoryProduct-cell-checkbox">Chọn</th>
                                    <th>Tên danh mục</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var category in Model.CategoryProducts)
                                {
                                    <tr>
                                        <td class="setting-categoryProduct-cell-checkbox">
                                            @if (Model.Setting.CategoryProducts.Split(',').Contains(category.Id.ToString()))
                                            {
                                                <input type="checkbox" class="categoryProduct-checkbox" data-checkbox="@category.Id" value="@category.Id" checked>
                                            }
                                            else
                                            {
                                                <input type="checkbox" class="categoryProduct-checkbox" data-checkbox="@category.Id" value="@category.Id">
                                            }

                                        </td>
                                        <td>@category.Name</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>


        @* Bác sĩ *@
        <div class="col-12" id="setting-section-doctor">
            <div class="card">
                <div class="card-header">
                    <div class="col-12">
                        <div id="setting-doctor-header" class="form-check form-switch">
                            <input type="hidden" asp-for="@Model.Setting.Doctors" id="doctorIdsInput">
                            <input class="form-check-input" type="checkbox" asp-for="@Model.Setting.ShowDoctorSlideList" id="setting_show_doctor">
                            <label class="form-check-label" asp-for="@Model.Setting.ShowDoctorSlideList">Slide bác sĩ</label>
                        </div>
                    </div>
                </div>
                @{
                    string doctorDisplay = Model.Setting.ShowDoctorSlideList ? "block" : "none";
                    <div class="card-body row g-3 setting-doctor-body" style="display: @doctorDisplay">
                        <div class="col-12">
                            <label asp-for="@Model.Setting.DoctorListTitle" class="form-label">Tiêu đề</label>
                            <input type="text" class="form-control" asp-for="@Model.Setting.DoctorListTitle">
                        </div>
                        <div class="col-12">
                            <label asp-for="@Model.Setting.DoctorListSubTitle" class="form-label">Tiêu đề phụ</label>
                            <input type="text" class="form-control" asp-for="@Model.Setting.DoctorListSubTitle">
                        </div>
                        <!-- Table -->
                        <table id="doctorTableList" class="table table-striped table-hover table-bordered">
                            <thead>
                                <tr>
                                    <th class="setting-doctor-cell-checkbox">Chọn</th>
                                    <th>Tên bác sĩ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doctor in Model.Doctors)
                                {
                                    <tr>
                                        <td class="setting-doctor-cell-checkbox">
                                            @if (Model.Setting.Doctors.Split(',').Contains(doctor.Id.ToString()))
                                            {
                                                <input type="checkbox" class="doctor-checkbox" data-checkbox="@doctor.Id" value="@doctor.Id" checked>
                                            }
                                            else
                                            {
                                                <input type="checkbox" class="doctor-checkbox" data-checkbox="@doctor.Id" value="@doctor.Id">
                                            }

                                        </td>
                                        <td>@doctor.Name</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

