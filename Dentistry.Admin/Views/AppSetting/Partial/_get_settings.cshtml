</div>


<script src="~/js/app-setting.js"></script>
<script>
    (function () {
        var $manualFields = $('#smtp-manual-fields');
        var $noteHosting = $('#smtp-note-hosting');
        var $noteGmail = $('#smtp-note-gmail');
        var $host = $('#Setting_SmtpHost');
        var $port = $('#Setting_SmtpPort');
        var $ssl = $('#Setting_SmtpUseSsl');
        var $username = $('#Setting_SmtpUsername');
        var $password = $('#Setting_SmtpPassword');
        var $senderName = $('#Setting_SmtpSenderName');
        var $notificationEmails = $('#Setting_NotificationEmails');

        // Giá trị Host/Port/SSL do admin tự nhập cho Hosting - lưu tạm để khôi phục khi chuyển qua lại Gmail rồi quay về
        var savedHostingValues = null;

        function applyBranch(provider) {
            if (provider === 'Gmail') {
                if (savedHostingValues === null) {
                    savedHostingValues = { host: $host.val(), port: $port.val(), ssl: $ssl.prop('checked') };
                }
                if (!$host.val()) { $host.val('smtp.gmail.com'); }
                if (!$port.val()) { $port.val('587'); }
                $ssl.prop('checked', true);
                $manualFields.hide();
                $noteHosting.hide();
                $noteGmail.show();
            } else {
                if (savedHostingValues !== null) {
                    $host.val(savedHostingValues.host);
                    $port.val(savedHostingValues.port);
                    $ssl.prop('checked', savedHostingValues.ssl);
                    savedHostingValues = null;
                }
                $manualFields.show();
                $noteGmail.hide();
                $noteHosting.show();
            }
        }

        $(document).on('change', 'input[name="Setting.SmtpProvider"]', function () {
            applyBranch($(this).val());
        });

        // Hiển thị đúng nhánh theo giá trị đã lưu khi tải trang / tải lại cài đặt
        applyBranch($('input[name="Setting.SmtpProvider"]:checked').val() || 'Hosting');

        // Làm mờ (không khoá input) phần cấu hình SMTP khi tắt công tắc tổng - admin vẫn có
        // thể chỉnh sửa/lưu cấu hình trong lúc tắt, chỉ là email sẽ không được gửi đi.
        var $notificationEnabled = $('#smtp-notification-enabled');
        var $configWrap = $('#smtp-config-wrap');
        function applyNotificationEnabledToggle() {
            $configWrap.toggleClass('opacity-50', !$notificationEnabled.is(':checked'));
        }
        $notificationEnabled.on('change', applyNotificationEnabledToggle);
        applyNotificationEnabledToggle();

        // Chỉ cho sửa nội dung email khách hàng khi đã bật checkbox gửi email cho khách
        var $sendCustomerEmail = $('#smtp-send-customer-email');
        var $customerTemplateWrap = $('#smtp-customer-template-wrap');
        function applyCustomerEmailToggle() {
            // Dùng readonly thay vì disabled - input bị disabled sẽ KHÔNG được gửi lên khi submit
            // form, dẫn tới nội dung mẫu đã lưu bị ghi đè thành rỗng mỗi khi tắt checkbox rồi lưu.
            var isOff = !$sendCustomerEmail.is(':checked');
            $customerTemplateWrap.toggleClass('opacity-50', isOff);
            $customerTemplateWrap.find('textarea').prop('readonly', isOff);
        }
        $sendCustomerEmail.on('change', applyCustomerEmailToggle);
        applyCustomerEmailToggle();

        // Gửi thử với đúng giá trị đang gõ trên form (chưa cần bấm Cập nhật trước) - nếu để
        // trống Mật khẩu thì server sẽ tự dùng lại mật khẩu đã lưu trong DB (nếu có).
        $(document).on('click', '#btn-test-smtp', function () {
            var $btn = $(this);
            var $result = $('#smtp-test-result');
            $result.addClass('d-none').removeClass('alert alert-success alert-danger').text('');
            $btn.prop('disabled', true).text('Đang gửi...');
            var payload = {
                smtpProvider: $('input[name="Setting.SmtpProvider"]:checked').val(),
                smtpHost: $host.val(),
                smtpPort: parseInt($port.val(), 10) || null,
                smtpUseSsl: $ssl.prop('checked'),
                smtpUsername: $username.val(),
                smtpPassword: $password.val(),
                smtpSenderName: $senderName.val(),
                notificationEmails: $notificationEmails.val()
            };
            $.ajax({
                url: '/AppSetting/TestSmtp',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response.isSuccessed) {
                        $result.removeClass('d-none alert-danger').addClass('alert alert-success py-1 px-2 mb-0')
                            .text('Gửi email thử nghiệm thành công.');
                    } else {
                        $result.removeClass('d-none alert-success').addClass('alert alert-danger py-1 px-2 mb-0')
                            .text(response.message || 'Gửi email thử nghiệm thất bại.');
                    }
                },
                error: function (xhr) {
                    $result.removeClass('d-none alert-success').addClass('alert alert-danger py-1 px-2 mb-0')
                        .text('Gửi email thử nghiệm thất bại: ' + xhr.responseText);
                },
                complete: function () {
                    $btn.prop('disabled', false).text('Gửi thử');
                }
            });
        });

        // ===== Mục lục (TOC): highlight mục đang xem khi cuộn, click để nhảy tới, ẩn/hiện =====
        // Container cuộn thật sự là #tabSettingContent (bên ngoài partial này) - #app-setting-form
        // chỉ là 1 tab-pane bên trong nó, không tự cuộn.
        var $scrollContainer = $('#tabSettingContent').length ? $('#tabSettingContent') : $(window);
        var $toc = $('#appSettingToc');
        var $tocLinks = $toc.find('.app-setting-toc-link');

        // Dùng .offset() (toạ độ tuyệt đối trên trang) thay vì .offsetTop (phụ thuộc ancestor
        // gần nhất có position != static, có thể không phải là chính scroll container) để tính
        // đúng vị trí của từng section so với gốc nội dung cuộn, bất kể CSS positioning bên trên.
        function getContainerOffsetTop() {
            var off = $scrollContainer.offset && $scrollContainer.offset();
            return off ? off.top : 0;
        }

        function getTocSections() {
            var containerOffsetTop = getContainerOffsetTop();
            var containerScrollTop = $scrollContainer.scrollTop() || 0;
            return $tocLinks.map(function () {
                var el = document.getElementById($(this).data('target'));
                if (!el) return null;
                return { id: el.id, top: $(el).offset().top - containerOffsetTop + containerScrollTop };
            }).get().filter(Boolean);
        }

        function updateActiveTocLink() {
            var scrollTop = ($scrollContainer.scrollTop() || 0) + 24; // offset nhỏ để chuyển mục sớm hơn 1 chút
            var sections = getTocSections();
            var currentId = sections.length ? sections[0].id : null;
            sections.forEach(function (section) {
                if (section.top <= scrollTop) {
                    currentId = section.id;
                }
            });
            $tocLinks.removeClass('active');
            if (currentId) {
                $toc.find('.app-setting-toc-link[data-target="' + currentId + '"]').addClass('active');
            }
        }

        // Namespaced để lần load lại (loadSettingData chèn lại HTML) không bị cộng dồn handler
        $scrollContainer.off('scroll.appSettingToc').on('scroll.appSettingToc', updateActiveTocLink);
        updateActiveTocLink();

        $toc.on('click', '.app-setting-toc-link', function (e) {
            e.preventDefault();
            var target = document.getElementById($(this).data('target'));
            if (!target) return;
            var targetTop = $(target).offset().top - getContainerOffsetTop() + ($scrollContainer.scrollTop() || 0);
            $scrollContainer.animate({ scrollTop: targetTop - 10 }, 300, function () {
                updateActiveTocLink();
            });
        });

        // Ẩn/hiện mục lục
        $('#appSettingTocToggle').on('click', function () {
            $toc.addClass('d-none');
            $('#appSettingTocOpenBtn').removeClass('d-none');
        });
        $(document).on('click', '#appSettingTocOpenBtn', function () {
            $toc.removeClass('d-none');
            $(this).addClass('d-none');
        });
    })();
</script>