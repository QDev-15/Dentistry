@using Dentistry.ViewModels.Catalog.Articles;
@model ArticleVmAddEdit
@{
    Layout = null;
}
<style>
    .tag-container {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        border: 1px solid #ddd;
        padding: 5px;
        border-radius: 5px;
        min-height: 40px;
    }

    .tag-item {
        background-color: #007bff;
        color: white;
        padding: 5px 10px;
        border-radius: 15px;
        display: inline-flex;
        gap: 5px;
    }

    .tag-remove {
        background: none;
        border: none;
        color: white;
        font-weight: bold;
        cursor: pointer;
        margin-top: -5px;
    }

    .tag-input {
        border: none;
        outline: none;
        flex-grow: 1;
        min-width: 100px;
    }

    .unsplash-thumb {
        width: 90px;
        height: 90px;
        object-fit: cover;
        border-radius: 4px;
        cursor: pointer;
        border: 2px solid transparent;
    }

    .unsplash-thumb:hover {
        border-color: #0d6efd;
    }

    .unsplash-thumb.selected {
        border-color: #198754;
    }
</style>
<div class="modal-header">
    @if (Model.Item.Alias.Contains("draft"))
    {
        <h5 class="modal-title" id="addArticleModalLabel">Thêm bài viết mới</h5>
    }
    else
    {
        <h5 class="modal-title" id="addArticleModalLabel">Cập nhật bài viết</h5>
    }
    <button type="button" class="btn-close action-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <form id="addArticleForm" asp-action="AddEdit" asp-controller="Articles" method="post" class="needs-validation" validate>
        <input type="hidden" asp-for="@Model.Item.Id" />
        <input type="hidden" id="artAlias" asp-for="@Model.Item.Alias" />
        <input type="hidden" asp-for="@Model.Item.IsDraft" />
        @* <input type="hidden" asp-for="@Model.Item.IsActive" /> *@
        <input type="hidden" asp-for="@Model.Item.ImageIds" />
        <div class="mb-3">
            <label asp-for="@Model.Item.Title" class="form-label">Tiêu đề</label>
            <input type="text" class="form-control" asp-for="@Model.Item.Title" placeholder="Nhập tiêu đề bài viết" required>
            <span asp-validation-for="@Model.Item.Title" class="text-danger"></span>
        </div>
        @{
            <div class="form-group">
                <label asp-for="@Model.Item.Type" class="form-label">Thể loại</label>
                <select asp-for="@Model.Item.Type" asp-items="@(IEnumerable<SelectListItem>)ViewBag.ArticleTypes" class="form-control">
                </select>
            </div>
        }
        <div class="form-group">
            <label asp-for="@Model.Item.CategoryId" class="form-label">Danh mục</label>
            <select class="form-select" asp-for="@Model.Item.CategoryId">
                @foreach (var item in Model.Categories)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </select>
        </div>
        <label>
            <input type="checkbox" asp-for="Item.IsActive" /> Kích hoạt
        </label>
        <div class="form-group">
            <label class="form-label">Ảnh đại diện <span class="text-danger">*</span></label>
            <ul class="nav nav-tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="avatar-tab-upload-btn" data-bs-toggle="tab" data-bs-target="#avatar-tab-upload" type="button" role="tab">Tải ảnh lên</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="avatar-tab-url-btn" data-bs-toggle="tab" data-bs-target="#avatar-tab-url" type="button" role="tab">Dán link ảnh</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="avatar-tab-unsplash-btn" data-bs-toggle="tab" data-bs-target="#avatar-tab-unsplash" type="button" role="tab">Tìm trên Unsplash</button>
                </li>
            </ul>
            <div class="tab-content border border-top-0 p-3">
                <div class="tab-pane fade show active" id="avatar-tab-upload" role="tabpanel">
                    <input asp-for="@Model.Item.AvatarFile" type="file" id="item_avatarFile" class="form-control ps-2" accept="image/*" />
                </div>
                <div class="tab-pane fade" id="avatar-tab-url" role="tabpanel">
                    <div class="input-group">
                        <input type="url" id="avatarUrlInput" class="form-control" placeholder="Dán đường dẫn ảnh (https://...)">
                        <button type="button" id="btn-preview-avatar-url" class="btn btn-outline-secondary">Xem trước</button>
                    </div>
                </div>
                <div class="tab-pane fade" id="avatar-tab-unsplash" role="tabpanel">
                    <div class="input-group mb-2">
                        <input type="text" id="unsplashQuery" class="form-control" placeholder="Nhập từ khóa (vd: dental clinic)">
                        <button type="button" id="btn-search-unsplash" class="btn btn-outline-secondary">Tìm kiếm</button>
                    </div>
                    <div id="unsplash-results" class="d-flex flex-wrap gap-2"></div>
                </div>
            </div>
            <input type="hidden" asp-for="@Model.Item.AvatarUrl" id="item_avatarUrl" />
            <span id="avatarFile-error" class="text-danger"></span>
        </div>
        @{
            var hasAvatar = !string.IsNullOrEmpty(Model.Item.Avatar?.Path);
            <div id="article-avatar-preview-container" style="display: @(hasAvatar ? "block" : "none")">
                <label>Xem trước:</label>
                <img id="article-avatar-preview" src="@Model.Item.Avatar?.Path" alt="Ảnh đại diện" class="mt-2" style="max-height: 100px;" />
            </div>
        }
        <div class="form-group">
            <label for="tags" class="form-label">Tags</label>
            <div class="tag-container" id="tagContainer">
                <input type="text" class="tag-input" id="tagInput" placeholder="Nhập tag và nhấn Enter">
            </div>
            <input type="hidden" asp-for="@Model.Item.Tags" id="tagsHidden">
        </div>

        <!-- Hidden field để lưu danh sách Tags -->
        <div class="mb-3">
            <label asp-for="@Model.Item.Description" class="form-label">Nội dung</label>
            <textarea asp-for="@Model.Item.Description" id="Item_Description"></textarea>
        </div>
    </form>
</div>
<div class="modal-footer d-flex justify-content-center">
    <button type="button" class="btn btn-secondary action-close" data-bs-dismiss="modal">Hủy</button>
    <button type="submit" form="addArticleForm" class="btn btn-primary">Lưu bài viết</button>
</div>


