<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Đa target để CÙNG MỘT project này dùng được cho cả ứng dụng chạy .NET Framework 4.8 lẫn
         ứng dụng .NET 8 hiện đại - một tiến trình .NET Framework không thể nạp assembly .NET
         Core/.NET 8 (khác CLR), nên không có target framework nào dùng chung được cho cả 2;
         MSBuild sẽ build project này 2 lần; mỗi target có ImageProcessing.dll riêng dưới
         bin\<Config>\<TFM>\. Trước đây dùng net10.0-windows thay vì net8.0-windows, nhưng phiên
         bản Visual Studio đang cài không hỗ trợ target .NET 10.0 (NETSDK1220) - net8.0-windows
         vừa sửa được lỗi vừa hợp lý hơn: một ứng dụng net8.0 vẫn không thể tham chiếu thư viện
         net10.0 dù VS có hỗ trợ đi nữa (NuGet luôn yêu cầu target framework của bên dùng phải >=
         target framework của thư viện). -->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <RootNamespace>ImageProcessing</RootNamespace>
    <AssemblyName>ImageProcessing</AssemblyName>
    <PlatformTarget>x86</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- ================= Chỉ riêng net8.0-windows: các gói NuGet quản lý ================= -->
  <ItemGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <!-- Các DLL đóng gói sẵn trong lib/ (PdfiumViewer, PdfSharp) được build dựa theo
         System.Drawing của .NET Framework và định danh assembly 4.0.0.0 của nó. Gói
         System.Drawing.Common của .NET tự type-forward từ định danh cũ đó, nên vẫn cần khai báo
         gói này dù code của chúng ta lấy Bitmap/... trực tiếp từ runtime. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.31" />
    <!-- Các gói phụ thuộc runtime riêng của PdfSharp (không có API nào trong code của chúng ta
         gọi trực tiếp - phát hiện được nhờ chạy thử từng luồng code của PdfSharp trên .NET
         Framework). Không gói nào có sẵn trong shared framework của .NET 8, nên phải khai báo
         PackageReference thật ở đây thay vì dùng bản đóng gói sẵn trong lib/ dành cho net48. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <!-- Các file lib/OpenCvSharp*.dll đóng gói sẵn (managed, build cho .NET Framework) bị crash
         trên .NET Core/.NET 5+: OpenCvSharp.Internal.WindowsLibraryLoader dò tìm
         "System.Web.HttpContext, System.Web" để nhận diện có đang chạy trong ASP.NET hay không,
         và assembly System.Web giả (rỗng) có sẵn trong .NET khiến Type.GetType đó ném
         TypeLoadException thay vì trả về null - lỗi này đã được vá ở các bản OpenCvSharp4 mới
         hơn. Chỉ cần bản vá nằm trong phần MANAGED, nên lấy từ NuGet ở đây, còn file gốc native
         x86 OpenCvSharpExtern.dll trong lib/ vẫn giữ nguyên để dùng (không khai báo gói
         OpenCvSharp4.runtime.win vì gói đó chỉ có bản dựng sẵn cho x64).
         Ghim ở bản 4.11.0.20250507 thay vì các bản 4.13.0.2026xxxx mới hơn: các bản mới đó yêu
         cầu System.Drawing.Common >= 10.0.9, chỉ tồn tại cho .NET 10, gây lỗi hạ cấp gói
         (NU1605, bị coi là lỗi build) khi dùng với net8.0. Bản 4.11.0.20250507 chỉ yêu cầu
         System.Drawing.Common >= 8.0.11, net8.0-windows đáp ứng được ngay. Nếu sau này nâng cấp
         phiên bản này, nhớ kiểm tra lại xem bản vá WindowsLibraryLoader nói trên có còn tồn tại
         trong bản mới hay không. -->
    <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.11.0.20250507" />
  </ItemGroup>

  <!-- ================= Chỉ riêng net48: các gói managed đóng gói sẵn (bộ gốc ban đầu) ================= -->
  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <Reference Include="OpenCvSharp">
      <HintPath>.\lib\OpenCvSharp.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="OpenCvSharp.Extensions">
      <HintPath>.\lib\OpenCvSharp.Extensions.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>.\lib\Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
      <Private>True</Private>
    </Reference>
    <Reference Include="System.Security.Cryptography.Pkcs">
      <HintPath>.\lib\System.Security.Cryptography.Pkcs.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
      <Private>True</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <!-- ================= Dùng chung cho cả 2 target ================= -->
  <ItemGroup>
    <Reference Include="zxing">
      <HintPath>.\lib\zxing.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="BitMiracle.LibTiff.NET">
      <HintPath>.\lib\BitMiracle.LibTiff.NET.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="PdfiumViewer">
      <HintPath>.\lib\PdfiumViewer.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="PdfSharp">
      <HintPath>.\lib\PdfSharp.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
      <Private>True</Private>
    </Reference>
    <Reference Include="Tesseract">
      <HintPath>.\lib\Tesseract.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Font đi kèm (DejaVu Sans, hỗ trợ tiếng Việt) dùng cho lớp text OCR vô hình. -->
    <EmbeddedResource Include="Assets\DejaVuSans.ttf" />

    <!-- File nhị phân native: dùng None+CopyToOutputDirectory (không dùng <Reference>) để đảm
         bảo được copy đúng xuống thư mục output của ứng dụng sử dụng, kể cả khi tham chiếu qua
         chuỗi ProjectReference nhiều tầng. Dùng chung cho cả 2 target - cùng 1 file native x86
         hoạt động được dù bản OpenCvSharp managed phía trên là bản đóng gói sẵn cho net48 hay
         bản lấy từ NuGet cho net8.0-windows. -->
    <None Include=".\lib\OpenCvSharpExtern.dll">
      <Link>OpenCvSharpExtern.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include=".\lib\opencv_videoio_ffmpeg4130.dll">
      <Link>opencv_videoio_ffmpeg4130.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include=".\lib\pdfium.dll">
      <Link>pdfium.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Các gói phụ thuộc runtime ẩn của PdfSharp.dll: không thấy được qua việc phân tích tham
         chiếu tĩnh (không có API nào trong code của chúng ta gọi trực tiếp), nên khai báo
         <Reference> thường sẽ không tự lan truyền qua chuỗi ProjectReference - chỉ copy kiểu
         Content mới lan truyền được (giống lý do ở trên). -->
    <None Include=".\lib\PdfSharp.System.dll">
      <Link>PdfSharp.System.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include=".\lib\PdfSharp.Shared.dll">
      <Link>PdfSharp.Shared.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- Runtime native của Tesseract (theo từng loại kiến trúc). Riêng Tesseract.dll (managed)
         ở trên là đủ để compile; các file dưới đây phải có mặt dưới x86/x64 cạnh file .exe của
         ứng dụng CUỐI CÙNG sử dụng thì tính năng OCR mới thực sự chạy được lúc runtime. -->
    <None Include=".\lib\x86\leptonica-1.80.0.dll">
      <Link>x86\leptonica-1.80.0.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include=".\lib\x86\tesseract41.dll">
      <Link>x86\tesseract41.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include=".\lib\x64\leptonica-1.80.0.dll">
      <Link>x64\leptonica-1.80.0.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include=".\lib\x64\tesseract41.dll">
      <Link>x64\tesseract41.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Chỉ riêng net48: các assembly "facade" này không được code của chúng ta tham chiếu trực
       tiếp (là phụ thuộc ẩn của PdfSharp) nhưng vẫn phải copy ra cạnh file .exe của ứng dụng
       net48 sử dụng; trên net8.0-windows các assembly này đã có sẵn trong runtime nên KHÔNG cần
       copy ra nữa (từng có bản build gặp lỗi xung đột phiên bản khi những file này bị copy thừa
       trên .NET hiện đại). -->
  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <None Include=".\lib\Microsoft.Bcl.AsyncInterfaces.dll">
      <Link>Microsoft.Bcl.AsyncInterfaces.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include=".\lib\Microsoft.Extensions.Logging.Abstractions.dll">
      <Link>Microsoft.Extensions.Logging.Abstractions.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include=".\lib\System.Security.Cryptography.Pkcs.dll">
      <Link>System.Security.Cryptography.Pkcs.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include=".\lib\System.Memory.dll">
      <Link>System.Memory.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include=".\lib\System.Buffers.dll">
      <Link>System.Buffers.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include=".\lib\System.Numerics.Vectors.dll">
      <Link>System.Numerics.Vectors.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
